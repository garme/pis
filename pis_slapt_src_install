#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
dialog --backtitle "$PIS_BACKTITLE" --title "Slapt-src" --yesno "Install slapt-src 0.3.9 for Slackware 15.0?" 7 60 || exit 0
pis_install_slapt_src || { pis_error "slapt-src could not be installed."; exit 1; }
slapt-src --update || { pis_error "slapt-src was installed, but its metadata could not be updated."; exit 1; }
pis_info "Slapt-src" "slapt-src was installed successfully."
