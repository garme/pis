#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
keymap_root="$(pis_path /usr/share/kbd/keymaps)"
items=()
while IFS= read -r path; do name="$(basename "$path")"; items+=("$name" ""); done < <(find "$keymap_root" -type f -name '*.map.gz' | sort)
[ "${#items[@]}" -gt 0 ] || { pis_error "No console keyboard maps were found."; exit 1; }
choice=$(dialog --stdout --backtitle "$PIS_BACKTITLE" --title "Console Keyboard Map" \
    --menu "Select a keyboard map. Current: $(pis_state_read keyboard_map)" 0 0 14 "${items[@]}") || exit 0
if pis_apply_console_keymap "$choice"; then
    pis_info "Console Keyboard Map" "The console keyboard map was set to '$choice'."
else
    pis_error "The console keyboard map could not be changed."
    exit 1
fi
