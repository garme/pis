#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
while true; do
    choice=$(dialog --stdout --backtitle "$PIS_BACKTITLE" --title "Graphical Environment" \
        --menu "Desktop: $(pis_state_read gui_desktop) | Keyboard: $(pis_state_read gui_keyboard)" 0 0 0 \
        desktop "Select the default desktop or window manager" \
        keyboard "Set the X keyboard layout") || exit 0
    case "$choice" in
        desktop) "$PIS_SBIN/pis_x_select_desktop_environment" ;;
        keyboard) "$PIS_SBIN/pis_x_set_keyboard_layout" ;;
    esac
done
