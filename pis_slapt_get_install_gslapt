#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
dialog --backtitle "$PIS_BACKTITLE" --title "GSlapt" --yesno "Install GSlapt 0.5.11 for Slackware 15.0?" 7 60 || exit 0
pis_install_gslapt || { pis_error "GSlapt could not be installed."; exit 1; }
pis_info "GSlapt" "GSlapt was installed successfully."
