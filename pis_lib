pis_install_slackpkgplus() {
    local repos="$1" filename url config tmp repo release arch repo_url
    release="$(pis_release)" || { pis_error "Unable to detect the Slackware release."; return 1; }
    arch="$(pis_arch)" || { pis_error "Unsupported architecture."; return 1; }
    for repo in $repos; do
        case "$repo" in
            multilib) [ "$arch" = x86_64 ] || { pis_error "Multilib is available only on x86_64."; return 1; } ;;
            alienbob|restricted) ;;
            *) pis_error "Unknown slackpkg+ repository: $repo"; return 1 ;;
        esac
    done
    filename="slackpkg+-1.8.0-noarch-7mt.txz"
    url="https://downloads.sourceforge.net/project/slackpkgplus/$filename"
    pis_download_install_package "$url" "$filename" || return 1
    config="$(pis_path /etc/slackpkg/slackpkgplus.conf)"
    [ -f "$config" ] || { pis_error "slackpkgplus.conf was not installed."; return 1; }
    tmp="$(pis_temp_file)" || return 1
    cp "$config" "$tmp" || { rm -f "$tmp"; return 1; }
    sed -i -E "s/^[[:space:]]*REPOPLUS=.*/REPOPLUS=( slackpkgplus $repos )/" "$tmp"
    for repo in multilib alienbob restricted; do
        sed -i -E "s|^[[:space:]]*(MIRRORPLUS\['$repo'\])|#\\1|" "$tmp"
    done
    sed -i '/^# BEGIN PIS REPOSITORIES$/,/^# END PIS REPOSITORIES$/d' "$tmp"
    {
        printf '\n# BEGIN PIS REPOSITORIES\n'
        for repo in $repos; do
            repo_url="$(pis_third_party_repository_url "$repo" "$release" "$arch")" || { rm -f "$tmp"; pis_error "No $repo repository is available for $release/$arch."; return 1; }
            printf "MIRRORPLUS['%s']='%s'\n" "$repo" "$repo_url"
        done
        printf '# END PIS REPOSITORIES\n'
    } >> "$tmp"
    grep -Fq 'REPOPLUS=(' "$tmp" || { rm -f "$tmp"; pis_error "Unable to configure slackpkg+."; return 1; }
    pis_replace_file "$tmp" "$config" "slackpkg-plus" "644" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    pis_state_write slackpkg_slackpkgplus "$repos"
    slackpkg update gpg && slackpkg update
}

pis_apply_slapt_repositories() {
    local repos="$1" config tmp repo source_url release arch
    command -v slapt-get >/dev/null 2>&1 || { pis_error "Install slapt-get first."; return 1; }
    release="$(pis_release)" || { pis_error "Unable to detect the Slackware release."; return 1; }
    arch="$(pis_arch)" || { pis_error "Unsupported architecture."; return 1; }
    config="$(pis_path /etc/slapt-get/slapt-getrc)"
    [ -f "$config" ] || { pis_error "$config was not found."; return 1; }
    tmp="$(pis_temp_file)" || return 1
    cp "$config" "$tmp" || { rm -f "$tmp"; return 1; }
    sed -i '/^# BEGIN PIS REPOSITORIES$/,/^# END PIS REPOSITORIES$/d' "$tmp"
    {
        printf '\n# BEGIN PIS REPOSITORIES\n'
        for repo in $repos; do
            source_url="$(pis_third_party_repository_url "$repo" "$release" "$arch")" || { rm -f "$tmp"; pis_error "No $repo repository is available for $release/$arch."; return 1; }
            printf 'SOURCE=%s\n' "$source_url"
        done
        printf '# END PIS REPOSITORIES\n'
    } >> "$tmp"
    pis_replace_file "$tmp" "$config" "slapt-repositories" "644" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    pis_state_write slapt_get_extra_repo "$repos"
    slapt-get --update
}

pis_third_party_repository_url() {
    local repo="$1" release="${2:-$(pis_release)}" arch="${3:-$(pis_arch)}"
    case "$release" in 15.0|current) ;; *) return 1 ;; esac
    case "$arch" in x86|x86_64) ;; *) return 1 ;; esac
    case "$repo" in
        alienbob) printf 'https://slackware.nl/people/alien/sbrepos/%s/%s/\n' "$release" "$arch" ;;
        restricted) printf 'https://slackware.nl/people/alien/restricted_sbrepos/%s/%s/\n' "$release" "$arch" ;;
        multilib) [ "$arch" = x86_64 ] && printf 'https://slackware.nl/people/alien/multilib/%s/\n' "$release" ;;
        *) return 1 ;;
    esac
}

pis_system_check() {
    local report="$1" version arch release bootloader issues=0
    version="$(cat "$(pis_path /etc/slackware-version)" 2>/dev/null || printf 'Unknown')"
    arch="$(pis_arch 2>/dev/null || printf unsupported)"
    release="$(pis_release 2>/dev/null || printf unknown)"
    bootloader="$(pis_available_bootloaders | awk 'BEGIN {sep=""} NF {printf "%s%s", sep, toupper($0); sep=","} END {if (sep == "") printf "none"}')"
    {
        printf 'PIS system check\n\n'
        printf 'Slackware: %s\nDetected branch: %s\nArchitecture: %s\nBootloader: %s\n\n' "$version" "$release" "$arch" "$bootloader"
        case "$release" in 15.0|current) printf '[OK] Supported Slackware branch\n' ;; *) printf '[FAIL] Unsupported or undetected Slackware branch\n'; issues=$((issues + 1)) ;; esac
        case "$arch" in x86|x86_64) printf '[OK] Supported architecture\n' ;; *) printf '[FAIL] Unsupported architecture\n'; issues=$((issues + 1)) ;; esac
        for command_name in dialog sed awk install mktemp; do
            if command -v "$command_name" >/dev/null 2>&1; then
                printf '[OK] %s available\n' "$command_name"
            else
                printf '[FAIL] %s missing\n' "$command_name"; issues=$((issues + 1))
            fi
        done
        [ -f "$(pis_path /etc/inittab)" ] && printf '[OK] /etc/inittab found\n' || { printf '[FAIL] /etc/inittab missing\n'; issues=$((issues + 1)); }
        [ -f "$(pis_path /etc/slackpkg/mirrors)" ] && printf '[OK] slackpkg mirror list found\n' || { printf '[WARN] slackpkg mirror list missing\n'; issues=$((issues + 1)); }
        printf '[INFO] Timezone: %s; hardware clock: %s\n' "$(pis_detect_timezone)" "$(pis_detect_hardwareclock)"
        if [ -f "$(pis_path /etc/rc.d/rc.ntpd)" ]; then
            pis_ntp_enabled && printf '[OK] NTP startup enabled; pool: %s\n' "$(pis_ntp_pool)" || printf '[INFO] NTP startup disabled\n'
        else
            printf '[INFO] NTP package/startup script not installed\n'
        fi
        [ "$bootloader" = none ] && printf '[INFO] No supported bootloader configuration detected\n' || \
            printf '[OK] Bootloader configuration(s) detected: %s\n' "$bootloader"
        printf '\nResult: %s issue(s) detected.\n' "$issues"
    } > "$report"
    return 0
}
