#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
while true; do
    choice=$(dialog --stdout --backtitle "$PIS_BACKTITLE" --title "Slapt-get Tools" \
        --menu "All package installers target Slackware 15.0 and the current architecture." 0 0 0 \
        slapt-get "Install slapt-get 0.11.11" \
        repositories "Add compatible third-party repositories" \
        gslapt "Install GSlapt 0.5.11" \
        slapt-src "Install slapt-src 0.3.9" \
        notifier "Build slapt-update-service through sbopkg") || exit 0
    case "$choice" in
        slapt-get) "$PIS_SBIN/pis_slapt_get_install" ;;
        repositories) "$PIS_SBIN/pis_slapt_get_install_extra_repositories" ;;
        gslapt) "$PIS_SBIN/pis_slapt_get_install_gslapt" ;;
        slapt-src) "$PIS_SBIN/pis_slapt_src_install" ;;
        notifier) "$PIS_SBIN/pis_slapt_update_notifier_install" ;;
    esac
done
