#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
command -v sbopkg >/dev/null 2>&1 || { pis_error "Install sbopkg first. slapt-update-service has no prebuilt package from its upstream project."; exit 1; }
dialog --backtitle "$PIS_BACKTITLE" --title "Slapt Update Service" \
    --yesno "Build and install slapt-update-service from SlackBuilds.org using sbopkg? Its dependencies will be shown by sbopkg." 9 70 || exit 0
sbopkg -i slapt-update-service || { pis_error "slapt-update-service could not be installed."; exit 1; }
pis_state_write slapt_get_slapt_update_notifier YES
pis_info "Slapt Update Service" "slapt-update-service was installed through SlackBuilds.org."
