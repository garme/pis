#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1

elilo_dir="$(pis_path /boot/efi/EFI/Slackware)"
[ -f "$elilo_dir/elilo.conf" ] || { pis_error "This module configures ELILO, but $elilo_dir/elilo.conf was not found."; exit 1; }
items=()
for kernel_path in "$(pis_path /boot)"/vmlinuz-generic-* "$(pis_path /boot)"/vmlinuz-huge-*; do
    [ -f "$kernel_path" ] && [ ! -L "$kernel_path" ] || continue
    kernel="$(basename "$kernel_path")"
    type="${kernel#vmlinuz-}"; type="${type%%-*}"
    items+=("$kernel" "$type kernel" off)
done
[ "${#items[@]}" -gt 0 ] || { pis_error "No Huge or Generic kernels were found in /boot."; exit 1; }
selected=$(dialog --stdout --separate-output --backtitle "$PIS_BACKTITLE" --title "ELILO Kernels" \
    --checklist "Select kernels to publish. Current: $(pis_state_read kernels)" 0 0 14 "${items[@]}") || exit 0
[ -n "$selected" ] || exit 0
selection_line="$(printf '%s\n' "$selected" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
dialog --backtitle "$PIS_BACKTITLE" --title "Confirm ELILO Configuration" \
    --yesno "Generate initrds as needed and publish these kernels?\n\n$selection_line\n\nThe current ELILO configuration and replaced files will be backed up automatically." 13 72 || exit 0
if pis_apply_kernels "$selection_line"; then
    pis_info "ELILO Kernels" "The selected kernels were published successfully. Reboot to test the new configuration."
else
    pis_error "The ELILO configuration was not completed."
    exit 1
fi
