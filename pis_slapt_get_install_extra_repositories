#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
selected=$(dialog --stdout --separate-output --backtitle "$PIS_BACKTITLE" --title "Slapt-get Repositories" \
    --checklist "These are third-party Slackware 15.0-compatible repositories. Review package origins before installation:" 0 0 0 \
    slackonly "SlackOnly 15.0 packages" off \
    salix "Salix 15.0 packages" off \
    salixextra "Salix extra 15.0 packages" off \
    slint "Slint 15.0 packages" off) || exit 0
[ -n "$selected" ] || exit 0
repos="$(printf '%s\n' "$selected" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
pis_apply_slapt_repositories "$repos" || { pis_error "Repositories could not be configured or updated."; exit 1; }
pis_info "Slapt-get Repositories" "The selected Slackware 15.0 repositories were added. Repositories for 'current' were intentionally rejected."
