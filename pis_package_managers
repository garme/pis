#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
while true; do
    choice=$(dialog --stdout --backtitle "$PIS_BACKTITLE" --title "Package Managers" \
        --menu "Select a package manager:" 0 0 0 \
        slackpkg "Configure Slackware's slackpkg" \
        sbopkg "Install or synchronize sbopkg" \
        slapt-get "Configure slapt-get tools") || exit 0
    case "$choice" in
        slackpkg) "$PIS_SBIN/pis_slackpkg" ;;
        sbopkg) "$PIS_SBIN/pis_sbopkg" ;;
        slapt-get) "$PIS_SBIN/pis_slapt_get" ;;
    esac
done
