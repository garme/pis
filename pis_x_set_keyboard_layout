#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
rules="$(pis_path /usr/share/X11/xkb/rules/base.lst)"
[ -r "$rules" ] || { pis_error "The XKB rules database was not found."; exit 1; }
layouts=()
while IFS=$'\t' read -r code description; do layouts+=("$code" "$description"); done < <(
    awk '/^! layout/{active=1; next} /^!/{if(active) exit} active && NF {code=$1; $1=""; sub(/^[[:space:]]+/,""); print code "\t" $0}' "$rules"
)
layout=$(dialog --stdout --backtitle "$PIS_BACKTITLE" --title "X Keyboard Layout" \
    --menu "Select a layout. Current: $(pis_state_read gui_keyboard)" 0 0 14 "${layouts[@]}") || exit 0
variants=()
while IFS=$'\t' read -r code description; do variants+=("$code" "$description"); done < <(
    awk -v prefix="$layout:" '/^! variant/{active=1; next} /^!/{if(active) exit} active && $2 == prefix {code=$1; $1=$2=""; sub(/^[[:space:]]+/,""); print code "\t" $0}' "$rules"
)
variant=""
if [ "${#variants[@]}" -gt 0 ] && dialog --backtitle "$PIS_BACKTITLE" --title "X Keyboard Variant" \
    --yesno "Select a variant for '$layout'?" 7 50; then
    variant=$(dialog --stdout --backtitle "$PIS_BACKTITLE" --title "X Keyboard Variant" \
        --menu "Select a variant:" 0 0 14 "${variants[@]}") || variant=""
fi
if pis_apply_x_keyboard "$layout" "$variant"; then
    pis_info "X Keyboard Layout" "The X keyboard was set to '$layout${variant:+:$variant}'. Restart X to apply it."
else
    pis_error "The X keyboard configuration could not be changed."
    exit 1
fi
