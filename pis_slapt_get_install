#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
dialog --backtitle "$PIS_BACKTITLE" --title "Slapt-get" --yesno "Install slapt-get 0.11.11 for Slackware 15.0?" 7 60 || exit 0
pis_install_slapt_get || { pis_error "slapt-get could not be installed. No OpenSSL compatibility links were created."; exit 1; }
slapt-get --update || { pis_error "slapt-get was installed, but its metadata could not be updated."; exit 1; }
pis_info "Slapt-get" "slapt-get was installed successfully."
