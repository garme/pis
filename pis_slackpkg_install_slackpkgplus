#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
[ "$(uname -m)" = x86_64 ] || { pis_error "The bundled slackpkg+ repository choices target Slackware64 15.0."; exit 1; }
dialog --backtitle "$PIS_BACKTITLE" --title "Slackpkg+" \
    --yesno "Install slackpkg+ 1.8.0 for third-party repositories?" 7 62 || exit 0
selected=$(dialog --stdout --separate-output --backtitle "$PIS_BACKTITLE" --title "Slackpkg+ Repositories" \
    --checklist "Enable only repositories intended for Slackware64 15.0:" 0 0 0 \
    multilib "32-bit compatibility libraries" off \
    alienbob "Alien Bob packages" off \
    restricted "Alien Bob restricted packages" off) || exit 0
repos="$(printf '%s\n' "$selected" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
pis_install_slackpkgplus "$repos" || { pis_error "slackpkg+ could not be installed or updated."; exit 1; }
pis_info "Slackpkg+" "slackpkg+ was installed and configured successfully."
