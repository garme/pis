#!/bin/bash
PIS_SBIN="${PIS_SBIN:-/sbin}"; . "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1
if command -v sbopkg >/dev/null 2>&1; then
    dialog --backtitle "$PIS_BACKTITLE" --title "Sbopkg" --yesno "sbopkg is installed. Synchronize its repository now?" 7 62 || exit 0
    sbopkg -r || { pis_error "The sbopkg repository could not be synchronized."; exit 1; }
    pis_state_write sbopkg YES
else
    dialog --backtitle "$PIS_BACKTITLE" --title "Sbopkg" --yesno "Install sbopkg 0.38.3 and synchronize SlackBuilds.org?" 7 62 || exit 0
    pis_install_sbopkg || { pis_error "sbopkg could not be installed."; exit 1; }
fi
pis_info "Sbopkg" "sbopkg is ready to use."
