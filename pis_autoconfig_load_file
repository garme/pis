#!/bin/bash

PIS_SBIN="${PIS_SBIN:-/sbin}"
. "$PIS_SBIN/pis_lib" 2>/dev/null || . "$(dirname "$0")/pis_lib" || exit 1
pis_init || exit 1

profile="${1:-}"
[ -r "$profile" ] || { pis_error "Profile file not found: $profile"; exit 1; }

declare -A settings
allowed_keys=" PIS_PROFILE_VERSION language_country keyboard_map login kernels wheel_group user user_wheel gui_desktop gui_keyboard slackpkg_mirror slackpkg_slackpkgplus sbopkg slapt_get_install slapt_get_extra_repo slapt_get_gslapt slapt_get_slapt_src slapt_get_slapt_update_notifier "
line_number=0
while IFS= read -r line || [ -n "$line" ]; do
    line_number=$((line_number + 1))
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    case "$line" in *=*) ;; *) pis_error "Invalid profile line $line_number."; exit 1 ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$allowed_keys" in *" $key "*) ;; *) pis_error "Unknown profile key on line $line_number: $key"; exit 1 ;; esac
    [ -z "${settings[$key]+set}" ] || { pis_error "Duplicate profile key: $key"; exit 1; }
    settings[$key]="$value"
done < "$profile"

[ "${settings[PIS_PROFILE_VERSION]:-}" = "1" ] || {
    pis_error "This profile is not in the secure PIS 0.3 format. Re-export it with PIS 0.3; legacy profiles may contain plaintext passwords."
    exit 1
}

valid_yes_no() { [ "$1" = YES ] || [ "$1" = NO ]; }
valid_list() {
    local values="$1" allowed="$2" item
    for item in $values; do case " $allowed " in *" $item "*) ;; *) return 1 ;; esac; done
}

if [ -n "${settings[language_country]:-}" ]; then
    locale -a | grep -Fqx "${settings[language_country]}" || { pis_error "Unavailable locale: ${settings[language_country]}"; exit 1; }
fi
if [ -n "${settings[keyboard_map]:-}" ]; then
    find "$(pis_path /usr/share/kbd/keymaps)" -type f -name "${settings[keyboard_map]}" -print -quit | grep -q . || { pis_error "Unavailable keymap: ${settings[keyboard_map]}"; exit 1; }
fi
[ -z "${settings[login]:-}" ] || [ "${settings[login]}" = CLI ] || [ "${settings[login]}" = GUI ] || { pis_error "Invalid login mode."; exit 1; }
[ -z "${settings[wheel_group]:-}" ] || valid_yes_no "${settings[wheel_group]}" || { pis_error "Invalid wheel setting."; exit 1; }
[ -z "${settings[user_wheel]:-}" ] || valid_yes_no "${settings[user_wheel]}" || { pis_error "Invalid user wheel setting."; exit 1; }
[ -z "${settings[user]:-}" ] || printf '%s' "${settings[user]}" | grep -Eq '^[a-z_][a-z0-9_-]{0,31}$' || { pis_error "Invalid username in profile."; exit 1; }
[ -z "${settings[gui_desktop]:-}" ] || printf '%s' "${settings[gui_desktop]}" | grep -Eq '^xinitrc\.[A-Za-z0-9._+-]+$' || { pis_error "Invalid X session in profile."; exit 1; }
[ -z "${settings[gui_keyboard]:-}" ] || printf '%s' "${settings[gui_keyboard]}" | grep -Eq '^[A-Za-z0-9_-]+:[A-Za-z0-9_+-]*$' || { pis_error "Invalid X keyboard setting."; exit 1; }
[ -z "${settings[slackpkg_mirror]:-}" ] || printf '%s' "${settings[slackpkg_mirror]}" | grep -Eq '^https?://[^[:space:]]*slackware(64)?-15\.0/?$' || { pis_error "The profile mirror is not for Slackware 15.0."; exit 1; }
valid_list "${settings[slackpkg_slackpkgplus]:-}" "multilib alienbob restricted" || { pis_error "Invalid slackpkg+ repository."; exit 1; }
valid_list "${settings[slapt_get_extra_repo]:-}" "slackonly salix salixextra slint" || { pis_error "Invalid or incompatible slapt-get repository."; exit 1; }
for key in sbopkg slapt_get_install slapt_get_gslapt slapt_get_slapt_src slapt_get_slapt_update_notifier; do
    [ -z "${settings[$key]:-}" ] || valid_yes_no "${settings[$key]}" || { pis_error "Invalid value for $key."; exit 1; }
done
for kernel in ${settings[kernels]:-}; do
    printf '%s' "$kernel" | grep -Eq '^vmlinuz-(generic|huge)-[A-Za-z0-9._+-]+$' || { pis_error "Invalid kernel name: $kernel"; exit 1; }
done

preview="$(pis_temp_file)" || exit 1
{
    printf 'Validated PIS profile\n\n'
    for key in language_country keyboard_map login kernels wheel_group user user_wheel gui_desktop gui_keyboard slackpkg_mirror slackpkg_slackpkgplus sbopkg slapt_get_install slapt_get_extra_repo slapt_get_gslapt slapt_get_slapt_src slapt_get_slapt_update_notifier; do
        [ -n "${settings[$key]:-}" ] && printf '%-30s %s\n' "$key" "${settings[$key]}"
    done
    printf '\nEach changed system file will be backed up automatically.\n'
} > "$preview"
dialog --backtitle "$PIS_BACKTITLE" --title "Apply Profile" --textbox "$preview" 23 78
rm -f "$preview"
dialog --backtitle "$PIS_BACKTITLE" --title "Apply Profile" --yesno "Apply this validated profile?" 7 50 || exit 0

failures=""
apply_step() {
    local name="$1"; shift
    if ! "$@"; then failures="${failures}${failures:+, }$name"; fi
}

[ -z "${settings[language_country]:-}" ] || apply_step language_country pis_apply_locale "${settings[language_country]}"
[ -z "${settings[keyboard_map]:-}" ] || apply_step keyboard_map pis_apply_console_keymap "${settings[keyboard_map]}"
[ -z "${settings[login]:-}" ] || apply_step login pis_apply_login_mode "${settings[login]}"
[ -z "${settings[wheel_group]:-}" ] || apply_step wheel_group pis_apply_wheel "${settings[wheel_group]}"
[ -z "${settings[gui_desktop]:-}" ] || apply_step gui_desktop pis_apply_desktop "${settings[gui_desktop]}"
if [ -n "${settings[gui_keyboard]:-}" ]; then
    layout="${settings[gui_keyboard]%%:*}"; variant="${settings[gui_keyboard]#*:}"
    apply_step gui_keyboard pis_apply_x_keyboard "$layout" "$variant"
fi
[ -z "${settings[slackpkg_mirror]:-}" ] || apply_step slackpkg_mirror pis_apply_slackpkg_mirror "${settings[slackpkg_mirror]}"
[ "${settings[slapt_get_install]:-NO}" != YES ] || apply_step slapt_get_install pis_install_slapt_get
[ -z "${settings[slapt_get_extra_repo]:-}" ] || apply_step slapt_get_extra_repo pis_apply_slapt_repositories "${settings[slapt_get_extra_repo]}"
[ "${settings[slapt_get_gslapt]:-NO}" != YES ] || apply_step slapt_get_gslapt pis_install_gslapt
[ "${settings[slapt_get_slapt_src]:-NO}" != YES ] || apply_step slapt_get_slapt_src pis_install_slapt_src
[ "${settings[sbopkg]:-NO}" != YES ] || apply_step sbopkg pis_install_sbopkg
[ -z "${settings[slackpkg_slackpkgplus]:-}" ] || apply_step slackpkg_slackpkgplus pis_install_slackpkgplus "${settings[slackpkg_slackpkgplus]}"
if [ "${settings[slapt_get_slapt_update_notifier]:-NO}" = YES ]; then
    if command -v sbopkg >/dev/null 2>&1; then
        if sbopkg -i slapt-update-service; then
            pis_state_write slapt_get_slapt_update_notifier YES
        else
            failures="${failures}${failures:+, }slapt_get_slapt_update_notifier"
        fi
    else
        failures="${failures}${failures:+, }slapt_get_slapt_update_notifier"
    fi
fi
[ -z "${settings[kernels]:-}" ] || apply_step kernels pis_apply_kernels "${settings[kernels]}"

if [ -n "${settings[user]:-}" ]; then
    if getent passwd "${settings[user]}" >/dev/null; then
        pis_state_write user "${settings[user]}"
        pis_state_write user_wheel "${settings[user_wheel]:-NO}"
    else
        password=$(dialog --stdout --insecure --backtitle "$PIS_BACKTITLE" --title "Profile User" \
            --passwordbox "Set a new password for '${settings[user]}'. It is not stored:" 9 62) || password=""
        if [ -n "$password" ]; then
            apply_step user pis_add_system_user "${settings[user]}" "$password" "${settings[user_wheel]:-NO}"
            unset password
        else
            failures="${failures}${failures:+, }user"
        fi
    fi
fi

if [ -n "$failures" ]; then
    pis_error "The profile was applied partially. Failed items:\n$failures\n\nUse Status and Restore to inspect or revert changes."
    exit 1
fi
pis_info "Apply Profile" "The profile was applied and verified successfully."
